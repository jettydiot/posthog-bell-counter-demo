# Copy to .env and fill in. `.env` is gitignored — keep it that way.
#
# Every secret is read from the environment at startup. Nothing is read from
# disk by the service itself, nothing has a default, and a missing value is a
# hard startup failure rather than a silent fallback.

# ── Webhook ──────────────────────────────────────────────────────────────────
# Shared secret PostHog sends in the `x-webhook-secret` header. Minimum 16
# characters; compared in constant time. Generate one with:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# ── Jettyd ───────────────────────────────────────────────────────────────────
# One combined device: the servo and the LED panel are two drivers on the same
# ESP32-C6, so there is a single device id and both commands go to it.
JETTYD_BASE_URL=https://api.jettyd.com
JETTYD_API_TOKEN=
JETTYD_DEVICE_ID=

# ── PostHog ──────────────────────────────────────────────────────────────────
# Personal API key with the `query:read` scope.
POSTHOG_API_KEY=
POSTHOG_HOST=eu.posthog.com
# Every project whose device_claimed events count towards the total. If any one
# of these fails to answer, the display is left alone rather than showing a
# partial sum.
POSTHOG_PROJECT_IDS=131280,214227,218818
POSTHOG_EVENT=device_claimed

# ── Bell geometry ────────────────────────────────────────────────────────────
# The strike is one `servo.rotate`: out to BELL_STRIKE_ANGLE, hold, then back.
# The firmware owns the "back" half — BELL_REST_ANGLE must match `home_angle`
# in firmware/device.yaml, or the service and the board disagree about where
# rest is. Both in degrees, 0–180.
BELL_REST_ANGLE=90
BELL_STRIKE_ANGLE=45
# Dwell at the strike position before returning, in milliseconds. Too short and
# the clapper never reaches the bell; too long and rapid claims queue up.
BELL_HOLD_MS=250

# ── Reconciliation ───────────────────────────────────────────────────────────
# How often to re-query PostHog and repaint the panel without ringing, in
# minutes. Catches missed webhooks, paused destinations and restarts.
# 0 disables it — the display then only updates when a webhook arrives.
RECONCILE_INTERVAL_MINUTES=15

# ── Service ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000
# Timeout for each outbound HTTP request (Jettyd and PostHog), in milliseconds.
REQUEST_TIMEOUT_MS=10000
# debug | info | warn | error
LOG_LEVEL=info
